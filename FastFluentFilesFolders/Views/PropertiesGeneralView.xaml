<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FastFluentFilesFolders.Views.PropertiesGeneralView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FastFluentFilesFolders.Views"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Image Source="{Binding Icon}" Width="32" Height="32" VerticalAlignment="Center" />
            <TextBox Text="{Binding Name, Mode=TwoWay}"
                     FontSize="16"
                     VerticalAlignment="Center"
                     MinWidth="320"
                     MaxWidth="420" />
        </StackPanel>

        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding TypeLabelText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Grid.Column="1" Text="{Binding TypeText}" TextWrapping="Wrap" VerticalAlignment="Center"
						   IsTextSelectionEnabled="True"/>

                <TextBlock Grid.Row="1" Text="{Binding DescriptionLabelText}" VerticalAlignment="Center" Margin="0,0,4,0"
                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}"
						   IsTextSelectionEnabled="True"/>

                <TextBlock Grid.Row="2" Text="{Binding LocationLabelText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Location}" IsTextSelectionEnabled="True" TextWrapping="Wrap" VerticalAlignment="Center" />

                <TextBlock Grid.Row="3" Text="{Binding SizeLabelText}" VerticalAlignment="Center" Margin="0,0,4,0" />
				<TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Size}" IsTextSelectionEnabled="True" TextWrapping="Wrap" VerticalAlignment="Center" />

                <TextBlock Grid.Row="4" Text="{Binding SizeOnDiskLabelText}" VerticalAlignment="Center" Margin="0,0,4,0" />
				<TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SizeOnDisk}" IsTextSelectionEnabled="True" TextWrapping="Wrap" VerticalAlignment="Center" />

                <TextBlock Grid.Row="5" Text="{Binding ContainsLabelText}" VerticalAlignment="Center" Margin="0,0,4,0"
                           Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Contains}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Grid.Row="6" Text="{Binding CreatedLabelText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Created}" IsTextSelectionEnabled="True" TextWrapping="Wrap" VerticalAlignment="Center" />

                <TextBlock Grid.Row="7" Text="{Binding ModifiedLabelText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Modified}" IsTextSelectionEnabled="True" TextWrapping="Wrap" VerticalAlignment="Center" />

                <TextBlock Grid.Row="8" Text="{Binding AccessedLabelText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Accessed}" IsTextSelectionEnabled="True" TextWrapping="Wrap" VerticalAlignment="Center" />

                <TextBlock Grid.Row="9" Text="{Binding AttributesLabelText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <StackPanel Grid.Row="9" Grid.Column="1" Spacing="6">
                    <TextBlock Text="{Binding AttributesSummary}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox Content="{Binding ReadOnlyLabel}" IsChecked="{Binding IsReadOnly, Mode=TwoWay}" />
                        <CheckBox Content="{Binding HiddenLabel}" IsChecked="{Binding IsHidden, Mode=TwoWay}" />
                        <Button Content="{Binding AdvancedLabel}" VerticalAlignment="Center" Click="OnAdvancedClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>