<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FastFluentFilesFolders.Views.PropertiesDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    mc:Ignorable="d">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding HeaderText}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8,4">
            <tv:TableView ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="None"
                          SelectionUnit="Row"
                          CanSortColumns="False"
                          CanFilterColumns="False"
                          CanResizeColumns="True"
                          CanReorderColumns="False"
                          CornerButtonMode="None"
                          HeadersVisibility="Columns"
                          GridLinesVisibility="Horizontal"
                          HeaderGridLinesVisibility="None"
                          BorderThickness="0"
                          RowHeight="36"
                          RowMinHeight="32">
                <tv:TableView.Columns>
                    <tv:TableViewTextColumn Width="2*" Header="{Binding PropertyHeader}" Binding="{Binding Name}" />
                    <tv:TableViewTextColumn Width="3*" Header="{Binding ValueHeader}" Binding="{Binding Value}" />
                </tv:TableView.Columns>
            </tv:TableView>
        </Border>
    </Grid>
</UserControl>
