<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FastFluentFilesFolders.Views.MiddleFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FastFluentFilesFolders.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    xmlns:vm="using:FastFluentFilesFolders.ViewModels"
    xmlns:uc="using:FastFluentFilesFolders.UserControls"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    x:Name="MFV"
    mc:Ignorable="d">

	<Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <local:InvertVisibilityConverter x:Key="InvertVisibilityConverter"/>
        <local:ExpandGlyphConverter x:Key="ExpandGlyphConverter"/>
		<Style x:Key="ViewSizeButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
			<Setter Property="Foreground" Value="{StaticResource AccentAAFillColorSecondaryBrush}" />
		</Style>
		<Style x:Key="ToolbarBtn" TargetType="Button">
			<Setter Property="Width" Value="40"/>
			<Setter Property="Height" Value="36"/>
			<Setter Property="Padding" Value="8"/>
			<Setter Property="Margin" Value="2,0"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
	</Page.Resources>
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <CommandBar HorizontalAlignment="Left" OverflowButtonVisibility="Collapsed" IsDynamicOverflowEnabled="False" x:Name="ToolbarCmd"/>
            <uc:FileOperationsButton x:Name="FileOpsBtn" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </Grid>

        <uc:LrsTableView x:Name="FileGrid" Grid.Row="1"
              RowHeight="{Binding AppConfigs.MiddleFilesHeight}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
               SelectionMode="Extended"
               SelectionUnit="Row"
              CanResizeColumns="True"
              CanSortColumns="True"
              GridLinesVisibility="None"
              HeaderGridLinesVisibility="None"
              BorderThickness="0"
              Margin="0,10,0,0">
            <tv:TableView.Columns>
                <tv:TableViewTemplateColumn x:Name="ColName" Width="4*" CanSort="True" SortMemberPath="Name">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:FileSystemNodeViewModel">
                            <Grid DoubleTapped="OnRowDoubleTapped" Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Visibility="{x:Bind IsPlaceholder, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneTime}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        BorderThickness="0" Padding="2" Width="20" Height="20"
                                        Click="OnGroupToggleClick" Tag="{x:Bind}">
                                    <FontIcon FontSize="10"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              Glyph="{x:Bind IsGroupExpanded, Converter={StaticResource ExpandGlyphConverter}, Mode=OneWay}"/>
                                </Button>
                                <Image Grid.Column="0" Source="{x:Bind Icon, Mode=OneWay}"
                                       Margin="0,0,10,0"
                                       Visibility="{x:Bind IsPlaceholder, Converter={StaticResource InvertVisibilityConverter}, Mode=OneTime}"
                                       Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NameText" Grid.Column="2" Text="{x:Bind Name, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>

                <tv:TableViewTemplateColumn x:Name="ColModifiedDate" Width="2*" CanSort="True" SortMemberPath="LastModifiedTime">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:FileSystemNodeViewModel">
                            <TextBlock DoubleTapped="OnRowDoubleTapped"
                                       Text="{x:Bind LastModifiedTimeString, Mode=OneTime}"
                                       Visibility="{x:Bind IsPlaceholder, Converter={StaticResource InvertVisibilityConverter}, Mode=OneTime}"
                                       Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>

                <tv:TableViewTemplateColumn x:Name="ColCreatedDate" Width="2*" CanSort="True" SortMemberPath="FirstCreatedTime">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:FileSystemNodeViewModel">
                            <TextBlock DoubleTapped="OnRowDoubleTapped"
                                       Text="{x:Bind FirstCreatedTimeString, Mode=OneTime}"
                                       Visibility="{x:Bind IsPlaceholder, Converter={StaticResource InvertVisibilityConverter}, Mode=OneTime}"
                                       Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>

                <tv:TableViewTemplateColumn x:Name="ColSize" Width="*" CanSort="True" SortMemberPath="ExactSize">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:FileSystemNodeViewModel">
                            <Grid DoubleTapped="OnRowDoubleTapped" Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="{x:Bind VisualSize, Mode=OneWay}"
                                           Visibility="{x:Bind SizeTextVisibility, Mode=OneWay}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ML.CalculateSize, Mode=OneTime}"
                                           Visibility="{x:Bind CalculateSizeButtonVisibility, Mode=OneWay}"
                                           Foreground="{StaticResource AccentAAFillColorSecondaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Tapped="OnCalculateSizeTapped"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
            </tv:TableView.Columns>
        </uc:LrsTableView>

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibilityConverter}}"
                     VerticalAlignment="Top"/>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Padding="20,10,20,10">
            <TextBlock Text="{Binding DisplayedItemCount}" Foreground="#D6D6D6"/>
            <TextBlock Text="{Binding ML.ItemCountSuffix}" Foreground="#D6D6D6"/>
        </StackPanel>
    </Grid>
</Page>
