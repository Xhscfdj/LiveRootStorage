<Window
    x:Class="FastFluentFilesFolders.Views.PropertiesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrls="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 现代化标题栏：不写标题，左侧为可拖拽区域，右侧由系统叠加最小化/最大化/关闭按钮 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent"/>

        <ctrls:SelectorBar x:Name="Tabs"
                           Grid.Row="1"
                           Margin="24,8,24,0"
                           SelectionChanged="OnTabsSelectionChanged">
            <ctrls:SelectorBarItem x:Name="GeneralTab" IsSelected="True"/>
            <ctrls:SelectorBarItem x:Name="CompatibilityTab"/>
            <ctrls:SelectorBarItem x:Name="SignatureTab"/>
            <ctrls:SelectorBarItem x:Name="SecurityTab"/>
            <ctrls:SelectorBarItem x:Name="DetailsTab"/>
            <ctrls:SelectorBarItem x:Name="PreviousVersionsTab"/>
        </ctrls:SelectorBar>

        <ScrollViewer Grid.Row="2"
                      x:Name="ContentScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="ContentHost" Margin="24,12,24,16"/>
        </ScrollViewer>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="24,0,24,16">
            <Button x:Name="OkButton" MinWidth="90" Click="OnOkClick"/>
            <Button x:Name="CancelButton" MinWidth="90" Click="OnCancelClick"/>
            <Button x:Name="ApplyButton" MinWidth="90" Click="OnApplyClick"/>
        </StackPanel>
    </Grid>
</Window>