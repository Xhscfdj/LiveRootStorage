<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TableViewRepro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:WinUI.TableView"
    xmlns:local="using:TableViewRepro">

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Heavy 4-column TableView, swap every 1s, transitions OFF" VerticalAlignment="Center" />
            <TextBlock x:Name="Status" Text="ready" VerticalAlignment="Center" />
        </StackPanel>

        <tv:TableView Grid.Row="1" x:Name="GridT"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanSortColumns="False" CanResizeColumns="True"
                      RowHeight="34" BorderThickness="1">
            <tv:TableView.Columns>
                <tv:TableViewTemplateColumn Width="3*" CanSort="False">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:RowItem">
                            <Grid Opacity="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{x:Bind Icon}" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBox Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" Visibility="Collapsed"/>
                            </Grid>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Width="2*" CanSort="False">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:RowItem">
                            <TextBlock Text="{x:Bind ModifiedText}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Width="2*" CanSort="False">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:RowItem">
                            <TextBlock Text="{x:Bind CreatedText}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Width="*" CanSort="False">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:RowItem">
                            <Grid>
                                <TextBlock Text="{x:Bind SizeText}" Visibility="{x:Bind ShowSize}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <Button Content="计算大小" Visibility="{x:Bind ShowCalc}" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="6,2"/>
                            </Grid>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
            </tv:TableView.Columns>
        </tv:TableView>
    </Grid>
</Window>
